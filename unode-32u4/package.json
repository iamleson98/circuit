{
  "name": "unode-32u4",
  "version": "1.0.0",
  "description": "uNode32U4 — a bare ATmega32U4 USB dev board designed in tscircuit (React for circuits)",
  "type": "module",
  "main": "index.tsx",
  "scripts": {
    "dev": "tsci dev",
    "check": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.build.json && node fix-imports.mjs",
    "verify": "node verify.mjs",
    "render": "node render.mjs"
  },
  "keywords": [
    "tscircuit",
    "pcb",
    "atmega32u4",
    "usb",
    "electronics"
  ],
  "license": "MIT",
  "dependencies": {
    "@tscircuit/core": "^0.0.2104",
    "@tscircuit/props": "^0.0.694",
    "react": "^19.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "circuit-to-svg": "^0.0.444",
    "typescript": "^5.9.3"
  }
}
