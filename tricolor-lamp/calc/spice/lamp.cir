RP_9 v12 p_n_d9a_pin1 150
DP_D9a p_n_d9a_pin1 p_n_d9a_pin2 LEDW
DP_D9b p_n_d9a_pin2 p_n_d9b_pin2 LEDW
DP_D9c p_n_d9b_pin2 white_n LEDW
RP_10 v12 p_n_d10a_pin1 150
DP_D10a p_n_d10a_pin1 p_n_d10a_pin2 LEDB
DP_D10b p_n_d10a_pin2 p_n_d10b_pin2 LEDB
DP_D10c p_n_d10b_pin2 blue_n LEDB
RP_11 v12 p_n_d11a_pin1 150
DP_D11a p_n_d11a_pin1 p_n_d11a_pin2 LEDW
DP_D11b p_n_d11a_pin2 p_n_d11b_pin2 LEDW
DP_D11c p_n_d11b_pin2 white_n LEDW
RP_12 v12 p_n_d12a_pin1 220
DP_D12a p_n_d12a_pin1 p_n_d12a_pin2 LEDY
DP_D12b p_n_d12a_pin2 p_n_d12b_pin2 LEDY
DP_D12c p_n_d12b_pin2 p_n_d12c_pin2 LEDY
DP_D12d p_n_d12c_pin2 yellow_n LEDY
RP_13 v12 p_n_d13a_pin1 150
DP_D13a p_n_d13a_pin1 p_n_d13a_pin2 LEDW
DP_D13b p_n_d13a_pin2 p_n_d13b_pin2 LEDW
DP_D13c p_n_d13b_pin2 white_n LEDW
RP_14 v12 p_n_d14a_pin1 220
DP_D14a p_n_d14a_pin1 p_n_d14a_pin2 LEDY
DP_D14b p_n_d14a_pin2 p_n_d14b_pin2 LEDY
DP_D14c p_n_d14b_pin2 p_n_d14c_pin2 LEDY
DP_D14d p_n_d14c_pin2 yellow_n LEDY
RP_15 v12 p_n_d15a_pin1 150
DP_D15a p_n_d15a_pin1 p_n_d15a_pin2 LEDB
DP_D15b p_n_d15a_pin2 p_n_d15b_pin2 LEDB
DP_D15c p_n_d15b_pin2 blue_n LEDB
RP_16 v12 p_n_d16a_pin1 220
DP_D16a p_n_d16a_pin1 p_n_d16a_pin2 LEDY
