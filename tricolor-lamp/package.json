{
  "name": "tricolor-lamp",
  "version": "1.0.0",
  "description": "Tri-Color Lamp — a 12 V LED lamp that steps blue → white → yellow each time you flip the wall switch, designed in tscircuit",
  "type": "module",
  "scripts": {
    "dev:controller": "tsci dev controller/index.tsx",
    "dev:panel": "tsci dev led-panel/index.tsx",
    "check": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.build.json && node fix-imports.mjs",
    "verify": "node verify.mjs",
    "render": "node render.mjs",
    "math": "node calc/circuit_math.mjs",
    "sim": "node calc/sim_lamp.mjs",
    "test:firmware": "sh firmware/test/run.sh",
    "test:mutants": "python3 firmware/test/mutation_test.py"
  },
  "keywords": ["tscircuit", "pcb", "led", "lamp", "attiny85", "eeprom", "electronics"],
  "license": "MIT",
  "dependencies": {
    "@tscircuit/core": "^0.0.2104",
    "@tscircuit/props": "^0.0.694",
    "react": "^19.3.0"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/react": "^19.3.0",
    "circuit-to-svg": "^0.0.444",
    "typescript": "^5.9.3"
  }
}
